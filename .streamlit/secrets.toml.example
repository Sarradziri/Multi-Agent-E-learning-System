# Streamlit Community Cloud secrets template.
# ---------------------------------------------------------------------------
# Do NOT put real values here and do NOT commit a real secrets.toml
# (.streamlit/secrets.toml is gitignored). Instead, paste the filled-in
# version into your app's  Settings → Secrets  on https://share.streamlit.io.
#
# For LOCAL development you don't need this file — use a .env (see .env.example).
# ---------------------------------------------------------------------------

AZURE_OPENAI_ENDPOINT = "https://<your-resource>.cognitiveservices.azure.com/"
AZURE_OPENAI_API_KEY = "<your-azure-openai-api-key>"
AZURE_OPENAI_CHAT_DEPLOYMENT = "gpt-4o"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT = "text-embedding-3-small"
AZURE_OPENAI_API_VERSION = "2024-12-01-preview"
